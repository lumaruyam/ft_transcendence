# Owner: Track 1
# Copy this file to .env (git-ignored, see .gitignore) and fill in real values — never commit .env itself.


# Nginx reverse proxy — browser-facing ports (host port = container port).
# 42 machines use rootless Podman and can't bind ports < 1024, hence 8080/8443
# instead of 80/443. Change these if the ports are already taken on your machine.
HTTP_PORT=8080
HTTPS_PORT=8443
BIND_ADDRESS=127.0.0.1

# Postgres (docker-compose db service)
POSTGRES_USER=ft_transcendence
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ft_transcendence

# Backend — general (AppConfig.nodeEnv / host / port)
NODE_ENV=development
# Bind address for Fastify's app.listen({ host, port }) in server.ts. 0.0.0.0 so the
# backend is reachable from other docker-compose containers (e.g. Nginx); 127.0.0.1 would
# only accept connections from inside the backend container itself.
HOST=0.0.0.0
PORT=3000

# Backend — database (AppConfig.databaseUrl)
DATABASE_URL=postgresql://ft_transcendence:change_me@localhost:5432/ft_transcendence


# Backend — auth (AppConfig.jwtSecret)
JWT_SECRET=change_me

# Backend — Socket.IO CORS allow-list (backend/src/modules/kanban/hub.ts).
# Optional; defaults to "*" when unset. Set to the browser origin in real deployments,
# e.g. https://localhost:8443
CORS_ORIGIN=

# Backend — OAuth2 (AppConfig.oauthGithub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# https: the browser must only talk to the app over TLS (and the OAuth state cookie is then marked Secure)
GITHUB_OAUTH_REDIRECT_URI=https://localhost:8443/api/auth/oauth/github/callback

# Backend — encrypts OAuthAccount.accessToken/refreshToken at rest (AppConfig.oauthTokenEncryptionKey,
# see modules/auth/tokenCrypto.ts). Must be exactly 32 bytes hex-encoded (64 hex chars).
# Generate a real one with: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=change_me

# Backend — password of the admin page https://localhost:8443/api/admin/signup that opens/closes account creation
# (12+ characters). Empty or "change_me" = the page is disabled. `./transcendence start` asks for it on first run.
SIGNUP_ADMIN_PASSWORD=change_me

# Backend — Git webhooks (AppConfig.gitWebhookSecret)
GIT_WEBHOOK_SECRET=change_me
# Public https origin of the app (no trailing slash), e.g. https://transcendence.example.com. Linking a card to a
# branch then registers the GitHub webhook (POST <origin>/api/webhooks/git) on the repository automatically.
# Leave empty in local dev (GitHub cannot reach localhost): the webhook must then be added by hand or skipped.
WEBHOOK_PUBLIC_URL=

# Backend — Public API (AppConfig.publicApiRateLimitDefault)
PUBLIC_API_RATE_LIMIT_DEFAULT=100

# Backend — global rate limiting (AppConfig.rateLimit, @fastify/rate-limit plugin)
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# Backend — Files page limits (optional, these are the defaults)
# FOLDER_MAX_SUBFOLDERS=60
# FOLDER_MAX_DEPTH=8
